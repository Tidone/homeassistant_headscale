{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "description": "Headscale API access tokens are typically valid for 90-days. You can create a fresh Headscale API access token on your server."
      },
      "user": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "server": "Headscale server"
        },
        "description": "This integration monitors your Headscale network, it **DOES NOT** make your Home Assistant accessible via Tailscale VPN. \n\nTo authenticate with the Headscale server you'll need to create an API access token on your server."
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "client": {
        "name": "Client"
      },
      "online": {
        "name": "Online"
      }
    },
    "sensor": {
      "expires": {
        "name": "Expires"
      },
      "ip": {
        "name": "IP address"
      },
      "last_seen": {
        "name": "Last seen"
      },
      "user": {
        "name": "User"
      }
    }
  }
}
